#!/bin/bash

# Check if the 'pct' command is available (must run on Proxmox host)
if ! command -v pct &> /dev/null; then
    echo "Error: 'pct' could not be found. This script must be run on the Proxmox host machine."
    exit 1
fi

# Function to display usage
usage()
{
    cat <<EOF
Usage: $1 [OPTIONS]

Options:
  -h|--help                         Show this help message
  -n|--name         <name>          LXC container hostname
  -t|--target       <ssh_uri>       Target machine SSH address (e.g. 192.168.1.50)
  -P|--port         <port>          Target SSH port (default: 22)
  -i|--id           <id>            Proxmox container ID
  -s|--root-size    <size_gb>       Root filesystem size in GB (e.g. 8)
  -a|--ip           <ip|dhcp>       Container IP address or 'dhcp'
  -c|--cidr         <prefix>        Subnet prefix length (default: 24, ignored if dhcp)
  -b|--bridge       <bridge>        Proxmox bridge interface (e.g. vmbr0)
  -g|--gateway      <gateway_ip>    Gateway IP (ignored if dhcp)
  -m|--memory       <mb>            Memory in MB (e.g. 512)
  -C|--cores        <cores>         Number of CPU cores (default: 1)
  -d|--disk-storage <pool>          Proxmox storage pool (e.g. local-lvm)
  -p|--password     <password>      Container root password (min. 5 chars)
  -S|--ssh-password <password>      Target machine SSH password
  -N|--nameserver   <ip>            DNS nameserver (default: 1.1.1.1)
  -u|--unprivileged                 Create as unprivileged container (recommended)

Examples:
  # DHCP, unprivileged:
  $1 -n mycontainer -t 192.168.1.50 -P 22 -i 200 -s 8 -a dhcp \\
     -b vmbr0 -m 512 -C 2 -d local-lvm -p secret123 -S sshpass -u

  # Static IP:
  $1 -n mycontainer -t 192.168.1.50 -P 22 -i 200 -s 8 -a 192.168.1.100 \\
     -c 24 -b vmbr0 -g 192.168.1.1 -m 512 -C 2 -d local-lvm -p secret123 -S sshpass
EOF
    return 0
}

# Defaults
port=22
cidr=24
cores=1
nameserver="1.1.1.1"
unprivileged=0

# Parse command-line options
options=$(getopt -o hn:t:P:i:s:a:c:b:g:m:C:d:p:S:N:u \
    -l help,name:,target:,port:,id:,root-size:,ip:,cidr:,bridge:,gateway:,memory:,cores:,disk-storage:,password:,ssh-password:,nameserver:,unprivileged \
    -- "$@")

if [ $? -ne 0 ]; then
    usage "$(basename "$0")"
    exit 1
fi
eval set -- "$options"

while true; do
    case "$1" in
        -h|--help)            usage "$(basename "$0")"; exit 0 ;;
        -n|--name)            name=$2;          shift 2 ;;
        -t|--target)          target=$2;        shift 2 ;;
        -P|--port)            port=$2;          shift 2 ;;
        -i|--id)              id=$2;            shift 2 ;;
        -s|--root-size)       rootsize=$2;      shift 2 ;;
        -a|--ip)              ip=$2;            shift 2 ;;
        -c|--cidr)            cidr=$2;          shift 2 ;;
        -b|--bridge)          bridge=$2;        shift 2 ;;
        -g|--gateway)         gateway=$2;       shift 2 ;;
        -m|--memory)          memory=$2;        shift 2 ;;
        -C|--cores)           cores=$2;         shift 2 ;;
        -d|--disk-storage)    storage=$2;       shift 2 ;;
        -p|--password)        password=$2;      shift 2 ;;
        -S|--ssh-password)    passwordSSH=$2;   shift 2 ;;
        -N|--nameserver)      nameserver=$2;    shift 2 ;;
        -u|--unprivileged)    unprivileged=1;   shift ;;
        --)                   shift; break ;;
        *)                    break ;;
    esac
done

# Validate required parameters
missing=()
[ -z "$name" ]     && missing+=("--name")
[ -z "$target" ]   && missing+=("--target")
[ -z "$id" ]       && missing+=("--id")
[ -z "$rootsize" ] && missing+=("--root-size")
[ -z "$ip" ]       && missing+=("--ip")
[ -z "$bridge" ]   && missing+=("--bridge")
[ -z "$memory" ]   && missing+=("--memory")
[ -z "$storage" ]  && missing+=("--disk-storage")
[ -z "$password" ] && missing+=("--password")

if [ "$ip" != "dhcp" ]; then
    [ -z "$gateway" ] && missing+=("--gateway (required for static IP)")
fi

if [ ${#missing[@]} -gt 0 ]; then
    echo "Error: Missing required parameters: ${missing[*]}"
    echo ""
    usage "$(basename "$0")"
    exit 1
fi

if [ "${#password}" -lt 5 ]; then
    echo "Error: Container password must be at least 5 characters."
    exit 1
fi

# Check for sshpass (needed if SSH password provided)
if [ -n "$passwordSSH" ] && ! command -v sshpass &> /dev/null; then
    echo "Installing sshpass..."
    apt-get install -y sshpass
    if [ $? -ne 0 ]; then
        echo "Error: Failed to install 'sshpass'. Exiting."
        exit 1
    fi
fi

# Collect filesystem from target, excluding volatile/unnecessary paths
collectFS()
{
    tar -czf - -C / \
        --exclude="sys" \
        --exclude="dev" \
        --exclude="run" \
        --exclude="proc" \
        --exclude="tmp" \
        --exclude="lost+found" \
        --exclude="*.log" \
        --exclude="*.log.*" \
        --exclude="*.gz" \
        --exclude="*.sql" \
        --exclude="swap.img" \
        .
}

# Build the net0 parameter
if [ "$ip" = "dhcp" ]; then
    net_param="name=eth0,bridge=${bridge},ip=dhcp"
else
    net_param="name=eth0,bridge=${bridge},ip=${ip}/${cidr},gw=${gateway}"
fi

# Build the SSH command prefix
if [ -n "$passwordSSH" ]; then
    ssh_cmd="sshpass -p '$passwordSSH' ssh"
else
    ssh_cmd="ssh"
fi

# Create a secure temp file
tmpfile=$(mktemp /tmp/lxc-convert-XXXXXX.tar.gz)

echo "Pulling filesystem from root@$target:$port ..."
eval "$ssh_cmd" -p "$port" \
    -o StrictHostKeyChecking=no \
    -o ConnectTimeout=15 \
    "root@$target" \
    "\"$(declare -f collectFS); collectFS\"" > "$tmpfile"

if [ $? -ne 0 ] || [ ! -s "$tmpfile" ]; then
    echo "Error: Failed to pull filesystem from target machine."
    rm -f "$tmpfile"
    exit 1
fi

echo "Creating Proxmox LXC container $id ($name) ..."
# rootfs format for Proxmox 7+: storage:sizeGB
pct create "$id" "$tmpfile" \
    --description "Converted LXC - source: $target" \
    --hostname "$name" \
    --features nesting=1 \
    --memory "$memory" \
    --cores "$cores" \
    --nameserver "$nameserver" \
    --net0 "$net_param" \
    --unprivileged "$unprivileged" \
    --rootfs "${storage}:${rootsize}" \
    --password "$password" \
    --start 1

exit_code=$?
rm -f "$tmpfile"

if [ $exit_code -eq 0 ]; then
    echo "Success: Container $id ($name) created and started."
else
    echo "Error: 'pct create' failed with exit code $exit_code."
    exit $exit_code
fi
